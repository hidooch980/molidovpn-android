<!--
  The XML theme now carries the same Orbit values as AppAppearance.ORBIT.

  It used to hold the old green-grey palette (#A4D8BB on #101411) while the Kotlin
  UI drew the approved dark-glass + neon look. Anything the framework paints for
  us — the pre-inflate splash window, AlertDialogs, edit-text handles, ripple
  defaults — used those stale colours, so the app flashed a different green on
  launch and dialogs came up in a palette that no longer exists anywhere else.

  Parent is DarkActionBar-free *Dark*, not DayNight: the layout is designed for a
  dark canvas only, and DayNight let a phone in light mode hand the dialogs white
  surfaces with near-white text on them.
-->
<resources>
    <style name="Theme.Molido" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- mint / neon accents, straight from the approved mock -->
        <item name="colorPrimary">#2DD4BF</item>
        <item name="colorOnPrimary">#06201D</item>
        <item name="colorSecondary">#7088F2</item>
        <item name="colorError">#E5484D</item>
        <!-- void / raised / recessed surfaces -->
        <item name="android:colorBackground">#0C1222</item>
        <item name="colorSurface">#141C30</item>
        <item name="colorOnSurface">#EEF2FA</item>
        <item name="colorSurfaceVariant">#1C2640</item>
        <item name="colorOnSurfaceVariant">#9AA6C0</item>
        <item name="colorOutline">#26314F</item>
        <item name="android:navigationBarColor">#0C1222</item>
        <item name="android:statusBarColor">#0C1222</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Molido.AlertDialog</item>
   </style>

    <!--
      The window the system shows before onCreate finishes. Same void background
      as the canvas, so launching the app does not flash a lighter panel before
      the Orbit console appears.
    -->
    <style name="Theme.Molido.Starting" parent="Theme.Molido">
        <item name="android:windowBackground">#0C1222</item>
   </style>

    <!--
      Invisible, non-animating window used only to collapse the Quick Settings
      shade (see ShadeCollapseActivity). It must never paint anything: a normal
      theme would flash the void background over whatever is behind the shade.
    -->
    <style name="Theme.Molido.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
   </style>

    <style name="ThemeOverlay.Molido.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Molido.Dialog</item>
        <item name="colorSurface">#141C30</item>
        <item name="colorOnSurface">#EEF2FA</item>
        <item name="colorPrimary">#2DD4BF</item>
   </style>

    <style name="ShapeAppearance.Molido.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
   </style>

    <!--
      Porcelain: the light half of the theme switch.

      This is a second explicit theme, NOT a values-night/ split. The palette is
      the user's choice inside the app, not the phone's night setting, so a
      resource qualifier would pick the wrong one whenever the two disagree.
      MainActivity applies whichever of these matches AppAppearance.mode()
      before super.onCreate().

      Values mirror AppAppearance.PORCELAIN exactly. Anything the framework
      paints for us — dialogs, edit-text handles, ripple defaults, the pre-inflate
      window — reads from here, and a mismatch here is how a white app ends up
      with one black dialog.
    -->
    <style name="Theme.Molido.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">#12A594</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#4F6BED</item>
        <item name="colorError">#C9363B</item>
        <item name="android:colorBackground">#F6F8FB</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorSurfaceVariant">#EEF2F7</item>
        <item name="colorOnSurfaceVariant">#5B6478</item>
        <item name="colorOutline">#E2E8F0</item>
        <item name="android:navigationBarColor">#F6F8FB</item>
        <item name="android:statusBarColor">#F6F8FB</item>
        <!-- Dark icons in the bars: the bars are now near-white. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Molido.Light.AlertDialog</item>
   </style>

    <style name="ThemeOverlay.Molido.Light.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Molido.Dialog</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorPrimary">#0B7A6E</item>
   </style>
</resources>
