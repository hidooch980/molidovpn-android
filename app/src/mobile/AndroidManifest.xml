<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Supplied by -PadmobAppId=... only after the publisher registers the app.
             Empty by default: UMP and ad requests remain disabled until configured. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />
        <meta-data
            android:name="com.molido.vpn.ads.BANNER_AD_UNIT_ID"
            android:value="${ADMOB_BANNER_AD_UNIT_ID}" />
    </application>
</manifest>
